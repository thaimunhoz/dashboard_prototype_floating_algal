{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floating-algal-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    // Let the Worker answer /api/* before the static-asset handler.
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "MASKS",
      "bucket_name": "floating-algal-dashboard"
      // Set "remote": true to read the real bucket during `npm run dev`
      // (requires `npx wrangler login`). Without it, dev uses a local
      // simulated bucket seeded by `npm run seed:local`.
    }
  ],
  "vars": {
    // Folder in the bucket holding one <YYYY-MM-DD>/<YYYY-MM-DD>.shp per day.
    "MASK_PREFIX": "caribbea-sea-masks/"
  }
}
