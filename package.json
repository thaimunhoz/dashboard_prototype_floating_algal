    "@types/shpjs": "^3.4.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.0.0",
    "wrangler": "^4.138.0"
  }
